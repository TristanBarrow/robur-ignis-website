---
const steps = [
  {
    n: "01",
    title: "A conversation",
    body: "Thirty minutes, no charge. You describe what you've built and what worries you. We tell you honestly whether we're the right people — sometimes the answer is no, and you'll get that straight.",
  },
  {
    n: "02",
    title: "An assessment",
    body: "We read the code and the infrastructure the way an attacker or a traffic spike would. You get a written report: what's sound, what's urgent, what's merely untidy, ordered by what it would actually cost you.",
  },
  {
    n: "03",
    title: "The work",
    body: "Fix it yourself with the report in hand, or bring us in to do it. No lock-in either way — the assessment is yours regardless of what you decide next.",
  },
];
---

<section id="approach" class="scroll-mt-20 bg-olive-leaf/10 py-28 lg:py-36">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="reveal max-w-2xl">
      <span class="eyebrow text-copperwood">How it works</span>
      <h2
        class="mt-5 font-display text-[clamp(2rem,4.2vw,3.15rem)] font-normal leading-[1.12] tracking-[-0.015em] text-bark"
        style="font-variation-settings: 'opsz' 100;"
      >
        Three steps. No procurement theatre.
      </h2>
    </div>

    <ol class="mt-16 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        steps.map((step, i) => (
          <li class="reveal relative" data-delay={i * 90}>
            <div class="flex items-center gap-4">
              <span
                class="font-display text-2xl font-medium text-copperwood"
                style="font-variation-settings: 'opsz' 40;"
              >
                {step.n}
              </span>
              <span class="h-px flex-1 bg-olive-leaf/30" aria-hidden="true" />
            </div>

            <h3
              class="mt-6 font-display text-xl font-medium text-bark"
              style="font-variation-settings: 'opsz' 40;"
            >
              {step.title}
            </h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-bark-soft">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
