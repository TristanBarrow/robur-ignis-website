---
import { Image } from "astro:assets";
import portrait from "../assets/tristanbarrow.jpg";
import { site } from "../config";
---

<section id="top" class="grid-paper pb-20 pt-14 lg:pb-28 lg:pt-20">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_20rem] lg:gap-20">
      <div>
        <p class="label">Software delivery consulting</p>
        <h1
          class="mt-5 max-w-3xl font-display text-[clamp(2.2rem,4.8vw,3.75rem)] font-medium leading-[1.08] tracking-[-0.02em] text-ink"
        >
          Ship fast. Don't break things.
        </h1>

        <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-soft">
          If your team is shipping slowly or breaking things, I can help. I'll
          measure where you are with DORA metrics, the research-backed standard
          for software delivery, find what's holding you back, help you fix it,
          then measure again to make sure it's working.
        </p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
          I'm Tristan Barrow. I've devoted the last 5 years of my life to
          solving one problem. I help dev teams ship fast without breaking
          things and ensure what's built actually counts toward the company's
          bottom line. Book a call to see if I'm a good fit for you.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={site.bookingUrl} class="btn">Book a free 60-min intro session</a>
          <a href="#services" class="link text-green">How it works</a>
        </div>
      </div>

      <!-- Mounted like a print in a report: paper mat, hairline frame, caption. -->
      <figure class="max-w-[17rem] self-start lg:mt-2 lg:max-w-none">
        <div class="border-2 border-green bg-paper-deep p-2.5">
          <div class="aspect-[4/5] overflow-hidden">
            <!-- Cropped to head and shoulders: scaled about a point just above the chin. -->
            <Image
              src={portrait}
              alt="Tristan Barrow"
              widths={[400, 567]}
              sizes="(min-width: 1024px) 20rem, 17rem"
              class="h-full w-full origin-[50%_42%] scale-125 object-cover object-top"
              style="filter: saturate(0.9) contrast(1.04);"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
        <figcaption class="mt-3 flex items-baseline justify-between gap-4">
          <span class="font-display font-medium">Tristan Barrow</span>
          <span class="label text-green">Software engineer</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
