---
const topics = [
  {
    term: "Spec-based harnesses",
    detail: "Deterministic specs and checks that keep agents on track and make their output repeatable.",
  },
  {
    term: "Code visualization",
    detail: "Understand what the AI built without reading every line.",
  },
  {
    term: "Practical vs. hype",
    detail: "Which harnesses, software factories and multi-agent workflows pay off today, and which can wait.",
  },
  {
    term: "Stability",
    detail: "Time-tested, research-based practices for efficiency and stability, adapted to AI development.",
  },
];
---

<section id="services" class="scroll-mt-8 border-t border-rule py-20 lg:py-28">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2
        class="font-display text-[clamp(1.9rem,3.6vw,2.75rem)] font-medium leading-[1.12] tracking-[-0.015em]"
      >
        What I help with
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-ink-soft">
        You bring the codebase and a question, such as why your agents' output is
        inconsistent, how to review what they produce, or which workflow is
        worth adopting. We work through it on your code.
      </p>
    </div>

    <dl class="mt-14 grid gap-x-12 sm:grid-cols-2">
      {
        topics.map((t) => (
          <div class="border-t border-green py-5">
            <dt class="font-display text-xl font-medium text-green">{t.term}</dt>
            <dd class="mt-2 max-w-md leading-relaxed text-ink-soft">{t.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
