---
import { promoPrice, site } from "../config";

// One offer while the practice is new: paid coaching sessions,
// each preceded by a free intro call to check it's a fit.
const topics = [
  {
    term: "Security",
    detail: "Who can read what, where your keys live, and what your dependencies pull in.",
  },
  {
    term: "Scale",
    detail: "What happens to your database and your bill when traffic goes up tenfold.",
  },
  {
    term: "Architecture",
    detail: "Which early decisions will be expensive to undo, and which you can leave alone.",
  },
  {
    term: "AI-written code",
    detail: "Reading code you didn't write line by line, and deciding what to keep.",
  },
];
---

<section id="services" class="scroll-mt-8 border-t border-rule py-20 lg:py-28">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2
        class="font-display text-[clamp(1.9rem,3.6vw,2.75rem)] font-medium leading-[1.12] tracking-[-0.015em]"
      >
        How coaching works
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-ink-soft">
        Each session is an hour, on a video call or in person, just you and me.
        You bring the
        codebase and a question, such as whether it's safe to launch, why it
        slows down under load, or whether to restructure it before it grows. We
        work through it on your code.
      </p>
    </div>

    <dl class="mt-14 grid gap-x-12 sm:grid-cols-2">
      {
        topics.map((t) => (
          <div class="border-t border-green py-5">
            <dt class="font-display text-xl font-medium text-green">{t.term}</dt>
            <dd class="mt-2 max-w-md leading-relaxed text-ink-soft">{t.detail}</dd>
          </div>
        ))
      }
    </dl>

    <!-- Terms as a single ruled line, like the bottom of an invoice. -->
    <div
      class="mt-10 flex flex-col gap-3 border-y-2 border-ink py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
    >
      <div class="shrink-0">
        <p class="font-display text-2xl font-medium">
          {
            site.promo ? (
              <>
                <s class="font-normal text-ink-faint">${site.sessionPrice}</s> ${promoPrice}
              </>
            ) : (
              <>${site.sessionPrice}</>
            )
          }{" "}
          <span class="text-lg font-normal text-ink-soft">per one-hour session</span>
        </p>
        {
          site.promo && (
            <p class="note mt-1">
              Founding client rate: {site.promo.percentOff}% off for my first{" "}
              {site.promo.spots} clients, with code {site.promo.code}
            </p>
          )
        }
      </div>
      <p class="max-w-md text-ink-soft">
        Before any paid session there's a free 30-minute call, so we can both
        check it's a good fit. Sessions are booked one at a time, with no
        package to buy.
      </p>
    </div>
  </div>
</section>
