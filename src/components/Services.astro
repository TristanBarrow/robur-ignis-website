---
import { site } from "../config";

// One offer while the practice is new: paid coaching sessions,
// each preceded by a free intro call to check it's a fit.
const session = {
  name: "Coaching session",
  price: "$200",
  cadence: "1 hour · one-to-one · video call",
  summary:
    "Time with a senior engineer, focused on your code and your question. Bring what you've built, the decision you're stuck on, or the thing that worries you.",
  topics: [
    "Security: auth, secrets, exposed data, risky dependencies",
    "Scale: what will break when real traffic arrives",
    "Architecture: which decisions are load-bearing, and which are cheap to change",
    "Code you've written with AI and aren't sure you can trust",
  ],
};

const steps = [
  {
    n: "01",
    title: "Free intro call",
    body: "Thirty minutes, no charge. You tell me what you're building and what you need. If I'm not the right person, I'll say so.",
  },
  {
    n: "02",
    title: "A coaching session",
    body: "If it's a fit, book a one-hour session for $200. We work through your question directly, on your code where it helps.",
  },
  {
    n: "03",
    title: "Book again if it helped",
    body: "No packages and no commitment. Each session stands on its own.",
  },
];
---

<section id="services" class="scroll-mt-20 bg-cornsilk py-28 lg:py-36">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid gap-14 lg:grid-cols-[1fr_0.9fr] lg:gap-20">
      <div class="reveal">
        <span class="eyebrow text-olive-leaf">What I offer</span>
        <h2
          class="mt-5 font-display text-[clamp(2rem,4.2vw,3.15rem)] font-normal leading-[1.12] tracking-[-0.015em] text-bark"
          style="font-variation-settings: 'opsz' 60;"
        >
          One-to-one coaching for software built with AI.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-bark-soft">
          AI makes it fast to build. It doesn't tell you what's fragile. A
          session gets you a senior engineer's judgement on your specific
          situation, without a contract or a retainer.
        </p>

        <ul class="mt-10 space-y-3.5">
          {session.topics.map((line) => (
            <li class="flex gap-3">
              <svg
                class="mt-1.5 h-3.5 w-3.5 shrink-0 text-olive-leaf"
                viewBox="0 0 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2 7.5 5.5 11 12 3.5" />
              </svg>
              <span class="text-[0.95rem] leading-relaxed text-bark-soft">{line}</span>
            </li>
          ))}
        </ul>
      </div>

      <article
        class="reveal self-start rounded-sm bg-black-forest p-8 ring-1 ring-sunlit-clay lg:p-10"
        data-delay="120"
      >
        <h3
          class="font-display text-2xl font-medium text-cornsilk"
          style="font-variation-settings: 'opsz' 40;"
        >
          {session.name}
        </h3>

        <p
          class="mt-4 font-display text-5xl font-normal text-sunlit-clay"
          style="font-variation-settings: 'opsz' 60;"
        >
          {session.price}
        </p>
        <p class="mt-2 text-sm text-cornsilk/60">{session.cadence}</p>

        <p class="mt-6 text-[0.95rem] leading-relaxed text-cornsilk/70">
          {session.summary}
        </p>

        <a href={site.calendlyUrl} class="btn btn-primary mt-9 w-full">
          Book a free intro call
        </a>
        <p class="mt-4 text-center text-sm text-cornsilk/60">
          Starts with a free 30-minute intro call.
        </p>
      </article>
    </div>

    <div class="mt-24 border-t border-olive-leaf/20 pt-14">
      <span class="reveal eyebrow text-olive-leaf">How it works</span>
      <ol class="mt-8 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          steps.map((step, i) => (
            <li class="reveal" data-delay={i * 90}>
              <div class="flex items-baseline gap-3">
                <span
                  class="font-display text-lg font-medium text-olive-leaf"
                  style="font-variation-settings: 'opsz' 40;"
                >
                  {step.n}
                </span>
                <h3
                  class="font-display text-xl font-medium text-bark"
                  style="font-variation-settings: 'opsz' 40;"
                >
                  {step.title}
                </h3>
              </div>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-bark-soft">
                {step.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
