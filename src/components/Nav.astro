---
import Wordmark from "./Wordmark.astro";
import { nav, site } from "../config";
---

<header class="border-b border-rule">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-5 lg:px-8">
    <a href="#top" class="shrink-0" aria-label={`${site.name} — home`}>
      <Wordmark />
    </a>

    <nav class="flex items-center gap-6 text-sm sm:gap-8" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} class="hidden text-ink-soft hover:text-ember sm:inline">
            {item.label}
          </a>
        ))
      }
      <a href={site.calendlyUrl} class="link font-semibold text-ember">Book a call</a>
    </nav>
  </div>
</header>
