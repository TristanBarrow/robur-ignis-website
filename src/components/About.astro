---
// Single-founder framing. No invented team, no placeholder headshot grid —
// claiming depth you can't name reads worse than owning the scale you are.
const facts = [
  { figure: "20+", label: "years building production systems" },
  { figure: "Senior", label: "engineers only — no juniors on your code" },
  { figure: "Direct", label: "you work with the person doing the work" },
];
---

<section id="about" class="scroll-mt-20 bg-cornsilk py-28 lg:py-36">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid gap-16 lg:grid-cols-[1fr_0.85fr] lg:gap-24">
      <div class="reveal">
        <span class="eyebrow text-copperwood">Who we are</span>
        <h2
          class="mt-5 font-display text-[clamp(2rem,4.2vw,3.15rem)] font-normal leading-[1.12] tracking-[-0.015em] text-bark"
          style="font-variation-settings: 'opsz' 100;"
        >
          The great oaks of the software industry.
        </h2>

        <div class="mt-8 space-y-5 text-lg leading-relaxed text-bark-soft">
          <p>
            {/* TODO: replace with your own bio — years, domains, systems you
                built, scale you operated at. Specifics beat adjectives here;
                this paragraph is doing most of the selling on the page. */}
            Robur Ignis is led by <strong class="font-semibold text-bark">Tristan Barrow</strong>,
            an engineer who has spent a career building and operating the kind
            of infrastructure that quietly holds the internet up — the systems
            that don't get written about because they don't go down.
          </p>
          <p>
            For work that needs more hands, we draw on a network of engineers of
            the same vintage: people who ran production before it was managed
            for you, who have carried the pager, and who learned scale and
            security the expensive way so you don't have to.
          </p>
          <p>
            We are not sceptics about AI. We use it daily. We simply know what
            it cannot yet be trusted to decide — and that's precisely the ground
            where businesses are won or lost.
          </p>
        </div>

        <div class="mt-10 flex flex-wrap gap-x-12 gap-y-6">
          {
            facts.map((f) => (
              <div>
                <p
                  class="font-display text-3xl font-medium text-copperwood"
                  style="font-variation-settings: 'opsz' 40;"
                >
                  {f.figure}
                </p>
                <p class="mt-1 max-w-[13rem] text-sm leading-snug text-bark-soft/80">
                  {f.label}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Pull-quote panel: the brand thesis stated plainly. -->
      <aside class="reveal" data-delay="120">
        <figure
          class="relative h-full overflow-hidden rounded-sm bg-black-forest p-9 lg:p-11"
        >
          <div
            class="pointer-events-none absolute inset-0"
            aria-hidden="true"
            style="background: radial-gradient(70% 50% at 80% 100%, rgba(221,161,94,0.18) 0%, transparent 70%);"
          >
          </div>

          <div class="relative flex h-full flex-col justify-between gap-10">
            <blockquote
              class="font-display text-[1.6rem] font-normal leading-[1.35] tracking-[-0.01em] text-cornsilk"
              style="font-variation-settings: 'opsz' 72;"
            >
              The oak doesn't fight the fire. It's simply built to still be
              standing afterwards.
            </blockquote>

            <figcaption class="border-t border-cornsilk/15 pt-6">
              <p class="eyebrow text-sunlit-clay">Our thesis</p>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-cornsilk/60">
                Move at the speed AI makes possible. Keep the structural
                judgement that keeps you solvent when the traffic, the attackers
                or the auditors arrive.
              </p>
            </figcaption>
          </div>
        </figure>
      </aside>
    </div>
  </div>
</section>
