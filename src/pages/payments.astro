---
import Redirect from "../layouts/Redirect.astro";
import { promoPrice, site } from "../config";

// Without a payment link (STRIPE_LINK unset), send people to the pricing instead.
const to = site.stripePaymentLink || "/#services";
---

<Redirect to={to} title="Payments" heading="Taking you to checkout." button="Pay for a session">
  Pay for a ${site.sessionPrice} coaching session securely through Stripe.
  {
    site.promo && (
      <>
        Founding clients: use code {site.promo.code} for {site.promo.percentOff}% off your first session (${promoPrice}).
      </>
    )
  }
</Redirect>
