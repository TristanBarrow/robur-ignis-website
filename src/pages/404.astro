---
import Layout from "../layouts/Layout.astro";
import Wordmark from "../components/Wordmark.astro";
---

<Layout title="Page not found">
  <main
    id="main"
    class="flex min-h-screen flex-col items-center justify-center bg-black-forest px-6 text-center"
  >
    <a href="/" aria-label="Robur Ignis — home">
      <Wordmark tone="light" />
    </a>

    <p class="eyebrow mt-16 text-sunlit-clay">Error 404</p>
    <h1
      class="mt-5 max-w-lg font-display text-[clamp(2rem,5vw,3.25rem)] font-normal leading-[1.1] tracking-[-0.015em] text-cornsilk"
      style="font-variation-settings: 'opsz' 100;"
    >
      This branch didn't hold.
    </h1>
    <p class="mt-5 max-w-sm text-cornsilk/60">
      The page you're after doesn't exist — or it moved. The rest of the tree is
      still standing.
    </p>

    <a href="/" class="btn btn-primary mt-10">Back to safety</a>
  </main>
</Layout>
