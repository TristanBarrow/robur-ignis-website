---
import Layout from "../layouts/Layout.astro";
import Wordmark from "../components/Wordmark.astro";
---

<Layout title="Page not found">
  <main id="main" class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <a href="/" aria-label="Robur Ignis — home">
      <Wordmark />
    </a>

    <p class="label mt-16">Error 404</p>
    <h1
      class="mt-4 max-w-lg font-display text-[clamp(2rem,5vw,3.25rem)] font-medium leading-[1.1] tracking-[-0.015em]"
    >
      This branch didn't hold.
    </h1>
    <p class="mt-5 max-w-sm text-ink-soft">
      The page you're after doesn't exist, or it moved. The rest of the tree is
      still standing.
    </p>

    <a href="/" class="link mt-10 font-semibold text-ember">Back to the home page</a>
  </main>
</Layout>
