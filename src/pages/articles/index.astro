---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { formatDate } from "../../lib/date";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="Articles"
  description="Notes on security, scale and architecture for software built with AI."
>
  <!-- Full-height column so the footer sits at the bottom while the list is short. -->
  <div class="flex min-h-screen flex-col">
    <Nav />
    <main id="main" class="flex-1">
      <section class="mx-auto max-w-2xl px-6 pb-20 pt-14 lg:px-8 lg:pb-28 lg:pt-20">
        <h1
          class="font-display text-[clamp(2.2rem,4.8vw,3.25rem)] font-medium leading-[1.08] tracking-[-0.02em]"
        >
          Articles
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">
          Notes on security, scale and architecture for software built with AI.
        </p>

        <ul class="mt-12">
          {
            articles.map((article) => (
              <li class="border-t border-green py-6">
                <time class="label" datetime={article.data.pubDate.toISOString()}>
                  {formatDate(article.data.pubDate)}
                </time>
                <h2 class="mt-2 font-display text-2xl font-medium">
                  <a href={`/articles/${article.id}/`} class="link">
                    {article.data.title}
                  </a>
                </h2>
                <p class="mt-2 leading-relaxed text-ink-soft">{article.data.description}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </div>
</Layout>
