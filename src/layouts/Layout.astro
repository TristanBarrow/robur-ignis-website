---
import "../styles/global.css";
import { site } from "../config";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  // Share image path under public/, 1200×630.
  image?: string;
  // Extra schema.org objects for this page (e.g. an article's BlogPosting).
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  type = "website",
  image = site.defaultImage,
  schema = [],
} = Astro.props;
const pageTitle = `${title ?? site.homeTitle} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = image ? new URL(image, site.url).href : undefined;

const orgId = `${site.url}/#organization`;
const personId = `${site.url}/#tristan-barrow`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": orgId,
      name: site.name,
      url: site.url,
      description: site.description,
      email: site.email,
      slogan: site.tagline,
      logo: new URL(site.logo, site.url).href,
      image: new URL(site.defaultImage, site.url).href,
      founder: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: site.founder,
      jobTitle: "Software engineer",
      url: `${site.url}/#about`,
      worksFor: { "@id": orgId },
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      name: site.name,
      url: site.url,
      publisher: { "@id": orgId },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content="en_US" />
    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={pageTitle} />
          <meta name="twitter:image" content={imageUrl} />
        </>
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3f4ee" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Besley:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>

    <slot />

    {
      site.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
        />
      )
    }
  </body>
</html>
